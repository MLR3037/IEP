# Copy to .env.local and fill in. Leave blank to run in demo mode (browser-only storage).
VITE_AAD_CLIENT_ID=182b661d-db2a-4423-a5db-2e533d4ee3d3
VITE_AAD_TENANT_ID=a4adcc38-7b4e-485c-80f9-7d9ca4e83d64
# Site as hostname:/sites/path
VITE_SP_SITE=evokebehavioralhealthcom.sharepoint.com:/sites/EducationServices
VITE_SP_RECORDS_LIBRARY=IEP Records
VITE_SP_DOCS_LIBRARY=IEP Documents
