# Copy to .env.local and fill in. Leave blank to run in demo mode (browser-only storage).
VITE_AAD_CLIENT_ID=
VITE_AAD_TENANT_ID=
# Site as hostname:/sites/path
VITE_SP_SITE=evokebehavioralhealth.sharepoint.com:/sites/SpecialEducation
VITE_SP_RECORDS_LIBRARY=IEP Records
VITE_SP_DOCS_LIBRARY=IEP Documents
# Existing student list for the caseload view (defaults to VITE_SP_SITE / "Current Clients")
VITE_CASELOAD_SITE=evokebehavioralhealthcom.sharepoint.com:/sites/EvokeIntake
VITE_CASELOAD_LIST=Current Clients
